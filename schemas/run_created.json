{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "RUN_CREATED",
  "type": "object",
  "description": "First event of a run; its ts opens the benchmark's timed window.",
  "properties": {
    "question": {
      "type": "string",
      "minLength": 1
    },
    "budget": {
      "type": "number",
      "minimum": 0
    },
    "mode": {
      "type": "string",
      "minLength": 1
    }
  },
  "required": [
    "question"
  ]
}
