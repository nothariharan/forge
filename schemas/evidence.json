{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "EVIDENCE_ADDED",
  "type": "object",
  "properties": {
    "claims": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "text": {
            "type": "string",
            "minLength": 1
          },
          "ref": {
            "type": "string",
            "minLength": 1,
            "description": "DOI or arXiv id"
          },
          "quote_span": {
            "type": "string",
            "minLength": 1,
            "description": "verbatim quote from the source supporting the claim"
          }
        },
        "required": [
          "text",
          "ref",
          "quote_span"
        ]
      }
    }
  },
  "required": [
    "claims"
  ]
}
